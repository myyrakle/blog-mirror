DATABASE_URL=postgres://user:password@localhost/blog_mirror
NAVER_BLOG_ID=your_naver_blog_id
GITHUB_REPO_PATH=/path/to/local/github-blog-clone
GITHUB_REMOTE_URL=https://github.com/username/blog.git
GITHUB_USERNAME=your_github_username
GITHUB_TOKEN=ghp_your_personal_access_token
# Delay between Naver requests in milliseconds (default: 1000)
CRAWL_DELAY_MS=1500

# ── Admin dashboard (`blog-mirror serve`) ──
# Port to listen on (default: 8080)
WEB_PORT=8080
# HTTP Basic auth. Set BOTH to enable, or omit BOTH to disable.
# Setting only one is rejected at startup so auth can't be lost by accident.
WEB_USERNAME=your_dashboard_username
WEB_PASSWORD=your_dashboard_password
